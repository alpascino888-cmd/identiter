# Local development only. Generate a unique key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-this-with-a-unique-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Optional: set an absolute path for the SQLite file.
# DATABASE_PATH=/absolute/path/to/db.sqlite3
